/**
 * @file secrets.h.example
 * @brief 敏感配置模板
 *
 * 使用方法：
 *   1. 复制本文件为 main/secrets.h（同目录）
 *   2. 填入真实的飞书 Webhook 地址和 OTA 更新源
 *   3. main/secrets.h 已被 .gitignore 忽略，不会提交到仓库
 */

#ifndef __SECRETS_H__
#define __SECRETS_H__

/* 飞书自定义机器人 Webhook 地址
 * 获取方式：飞书群 -> 设置 -> 群机器人 -> 添加自定义机器人 -> 复制 Webhook 地址 */
#define FEISHU_WEBHOOK_URL "https://open.feishu.cn/open-apis/bot/v2/hook/替换为你的token"

/* OTA 更新源：GitHub 仓库最新 Release 的 API 地址
 * 格式: https://api.github.com/repos/<用户名>/<仓库名>/releases/latest
 * 设备每 24 小时检查一次，Release 的 tag 需为 vX.Y.Z 格式并附带 sms.bin */
#define OTA_RELEASE_API_URL "https://api.github.com/repos/你的用户名/你的仓库名/releases/latest"

#endif /* __SECRETS_H__ */
